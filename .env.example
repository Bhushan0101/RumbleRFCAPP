# Copy values into Render environment settings or export them in your shell.
# The server reads process variables; it does not automatically load this file.
WUCO_DEMO_MODE=1
WUCO_PAYMENT_MODE=demo
# Keep an existing database path unchanged when upgrading. Demo-only example:
# WUCO_DB_PATH=/tmp/wuco-demo.sqlite3
# Real provider setup (secure values must be entered outside source control):
# WUCO_PAYMENT_MODE=stripe
# WUCO_PUBLIC_URL=https://your-render-service.example
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# WUCO_FINANCE_DURABLE=1
# WUCO_DB_PATH=/var/data/wuco.sqlite3
