// W.U.C.O Ireland — Prisma schema (SQLite port of migrations 001-010).
// SQLite now; swap to postgres by changing `provider` + DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & sessions
// ---------------------------------------------------------------------------

model PortalUser {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String
  // 'admin' | 'promoter' | 'fighter' | 'gym' | 'coach'
  role          String
  salt          String
  passwordHash  String
  createdAt     DateTime @default(now())

  fighterProfile    FighterProfile?       @relation("FighterUser")
  createdProfiles   FighterProfile[]      @relation("CreatedBy")
  reviewedProfiles  FighterProfile[]      @relation("ReviewedBy")
  ownedGyms         Gym[]                 @relation("GymOwner")
  coachOf           Coach[]
  promotions        Promotion[]
  joinRequests      GymJoinRequest[]      @relation("Fighter")
  reviewedJoins     GymJoinRequest[]      @relation("Reviewer")
  bookings          ClassBooking[]
  applicationAudit  ApplicationAudit[]
  invitedEnquiries  GymEnquiry[]          @relation("Invited")
  reviewedEnquiries GymEnquiry[]          @relation("Reviewed")
  notifications     Notification[]
  newsPosts         NewsPost[]
  deletionRequests  AccountDeletionRequest[] @relation("DeletionRequester")
  verifications     VerificationRequest[]    @relation("VerificationOwner")
  passwordResets    PasswordReset[]

  @@map("portal_users")
}

model Session {
  tokenHash String   @id
  userId    Int
  expiresAt Int
  @@map("portal_sessions")
}

// Short-lived single-use token the user gets by email to reset their password.
model PasswordReset {
  token     String   @id
  userId    Int
  expiresAt Int       // unix seconds
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Athletes & passports
// ---------------------------------------------------------------------------

model Athlete {
  id           Int      @id @default(autoincrement())
  name         String
  nickname     String   @default("")
  division     String   @default("Featherweight")
  country      String   @default("")
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  biography    String?
  portraitUrl  String?
  cartoonUrl   String?
  // Fighter-managed social handles. We store the raw handle/URL; render-side
  // code builds the final profile URL via lib/socials.
  instagramHandle String  @default("")
  facebookUrl     String  @default("")
  tiktokHandle    String  @default("")
  isSample     Int      @default(1)
  displayOrder Int      @default(0)
  classCode    String?  // 'J' | 'N' | 'L' | 'C' | 'B' | 'A'
  martialArt   String   @default("")
  gender       String   @default("")   // 'male' | 'female' | ''
  dateOfBirth  String   @default("")   // ISO yyyy-mm-dd; optional at signup
  declaredWins   Int    @default(0)
  declaredLosses Int    @default(0)
  declaredDraws  Int    @default(0)

  profile    FighterProfile?
  passport   FighterPassport?
  rankings   Ranking[]
  boutsRed   Bout[]           @relation("Red")
  boutsBlue  Bout[]           @relation("Blue")
  wonBouts   Bout[]           @relation("Winner")
  entries    EventRegistration[]
  audits     ApplicationAudit[]
  fightHistory FightHistory[]
  disciplines AthleteDiscipline[]
  photos      FighterPhoto[]

  @@map("athletes")
}

// Fighter-uploaded photos that appear on their public profile.
// Separate from Athlete.portraitUrl (single headshot / passport photo).
model FighterPhoto {
  id         Int      @id @default(autoincrement())
  athleteId  Int
  url        String
  caption    String   @default("")
  createdAt  DateTime @default(now())
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@index([athleteId])
  @@map("fighter_photos")
}

// Per-discipline class + declared W-L-D. One row per (athlete, martialArt).
// The primary row is mirrored onto Athlete.martialArt/classCode/wins/losses/draws
// so existing read sites keep working unchanged.
model AthleteDiscipline {
  id         Int      @id @default(autoincrement())
  athleteId  Int
  martialArt String
  classCode  String?
  wins       Int      @default(0)
  losses     Int      @default(0)
  draws      Int      @default(0)
  isPrimary  Int      @default(0)
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, martialArt])
  @@map("athlete_disciplines")
}

model FighterProfile {
  athleteId       Int      @id
  userId          Int?     @unique
  gymId           Int?
  coachId         Int?
  approvalStatus  String   @default("pending_approval")
  legacyMember    Int      @default(1)
  createdById     Int?
  reviewedById    Int?
  reviewedAt      DateTime?
  reviewNote      String   @default("")
  hasInjuries     Int      @default(0)
  injuriesDetails String   @default("")
  injuryAnsweredAt DateTime?

  athlete    Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  user       PortalUser? @relation("FighterUser", fields: [userId], references: [id])
  gym        Gym?        @relation(fields: [gymId], references: [id])
  coach      Coach?      @relation(fields: [coachId], references: [id])
  createdBy  PortalUser? @relation("CreatedBy", fields: [createdById], references: [id])
  reviewedBy PortalUser? @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@map("fighter_profiles")
}

model FighterPassport {
  athleteId Int      @id
  fighterNo String   @unique
  issuedAt  DateTime @default(now())
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@map("fighter_passports")
}

model ApplicationAudit {
  id        Int      @id @default(autoincrement())
  athleteId Int
  actorId   Int?
  action    String
  note      String   @default("")
  createdAt DateTime @default(now())
  athlete   Athlete     @relation(fields: [athleteId], references: [id])
  actor     PortalUser? @relation(fields: [actorId], references: [id])
  @@map("application_audit")
}

// ---------------------------------------------------------------------------
// Gyms, products, classes, bookings
// ---------------------------------------------------------------------------

model Gym {
  id                 Int     @id @default(autoincrement())
  ownerId            Int?    @unique
  name               String
  city               String  @default("")
  joinCode           String? @unique
  logoUrl            String?
  heroUrl            String?
  about              String  @default("")
  revolutHandle      String  @default("")
  timetableImageUrl  String?
  slug               String? @unique
  status             String  @default("active")
  contactEmail       String  @default("")

  // Detailed onboarding fields (collected from the token-gated onboarding form)
  addressLine1        String  @default("")
  eircode             String  @default("")
  county              String  @default("")
  yearEstablished     Int?
  phone               String  @default("")
  website             String  @default("")
  socialLinks         String  @default("")     // free text / JSON blob
  membersTotal        Int?
  membersUnder18      Int?
  disciplines         String  @default("")     // CSV
  governingBody       String  @default("")

  // Head coach snapshot (free text — Coach model stays as the login role)
  coachName           String  @default("")
  coachRank           String  @default("")
  coachYearsTraining  Int?
  coachStyle          String  @default("")
  coachLastGradeYear  Int?
  coachPhone          String  @default("")
  coachEmail          String  @default("")
  coachQualifications String  @default("")
  coachYearsCoaching  Int?
  coachCertifications String  @default("")
  coachFirstAidExpiry String  @default("")     // ISO yyyy-mm-dd
  coachSafeguarding   String  @default("")
  coachGardaVetting   String  @default("")     // "verified 2024-02-01" etc.
  coachPhotoUrl       String?

  owner      PortalUser?       @relation("GymOwner", fields: [ownerId], references: [id])
  coaches    Coach[]
  fighters   FighterProfile[]
  products   GymProduct[]
  classes    GymClass[]
  joinReqs   GymJoinRequest[]
  photos     ClubPhoto[]
  closures   GymClosureRequest[]

  @@map("gyms")
}

model ClubPhoto {
  id        Int      @id @default(autoincrement())
  gymId     Int
  url       String
  caption   String   @default("")
  createdAt DateTime @default(now())
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  @@index([gymId])
  @@map("club_photos")
}

// Gym-initiated withdrawal from WUCO. Admin reviews and processes; closing
// the gym unlinks fighter profiles and flips the gym's status to 'withdrawn'.
model GymClosureRequest {
  id            Int      @id @default(autoincrement())
  gymId         Int
  requestedById Int?
  reason        String   @default("")
  status        String   @default("pending") // 'pending' | 'processed' | 'cancelled'
  createdAt     DateTime @default(now())
  processedAt   DateTime?
  processedById Int?
  gym           Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  @@index([status, createdAt(sort: Desc)])
  @@map("gym_closure_requests")
}

model Coach {
  id      Int    @id @default(autoincrement())
  userId  Int    @unique
  gymId   Int?
  name    String
  user    PortalUser @relation(fields: [userId], references: [id])
  gym     Gym?       @relation(fields: [gymId], references: [id])
  fighters FighterProfile[]
  @@map("coaches")
}

model GymProduct {
  id          Int     @id @default(autoincrement())
  gymId       Int
  // 'day_pass' | 'weekly_pass' | 'monthly_pass' | 'per_class'
  kind        String
  title       String
  priceCents  Int
  currency    String  @default("EUR")
  revolutUrl  String  @default("")
  active      Int     @default(1)
  gym         Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  @@map("gym_products")
}

model GymClass {
  id                Int     @id @default(autoincrement())
  gymId             Int
  title             String
  discipline        String  @default("")
  dayOfWeek         Int
  startTime         String
  durationMinutes   Int
  capacity          Int     @default(20)
  perClassPriceCents Int?
  revolutUrl        String  @default("")
  colour            String  @default("")
  gym               Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  bookings          ClassBooking[]
  @@map("gym_classes")
}

model ClassBooking {
  id            Int      @id @default(autoincrement())
  classId       Int
  userId        Int?
  guestName     String   @default("")
  guestEmail    String   @default("")
  bookedForDate String
  status        String   @default("pending_payment")
  createdAt     DateTime @default(now())
  markedPaidAt  DateTime?
  class         GymClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user          PortalUser? @relation(fields: [userId], references: [id])
  @@index([classId, bookedForDate])
  @@map("class_bookings")
}

model GymJoinRequest {
  id          Int      @id @default(autoincrement())
  gymId       Int
  userId      Int
  createdAt   DateTime @default(now())
  status      String   @default("pending")
  reviewedAt  DateTime?
  reviewedById Int?
  reviewNote  String   @default("")
  gym         Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user        PortalUser  @relation("Fighter", fields: [userId], references: [id])
  reviewer    PortalUser? @relation("Reviewer", fields: [reviewedById], references: [id])
  @@unique([gymId, userId])
  @@map("gym_join_requests")
}

model GymEnquiry {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  gymName      String
  contactName  String
  contactEmail String
  phone        String   @default("")
  city         String   @default("")
  message      String   @default("")
  status       String   @default("new")
  invitedById  Int?
  invitedAt    DateTime?
  reviewedById Int?
  reviewedAt   DateTime?
  reviewNote   String   @default("")
  invitedBy    PortalUser?         @relation("Invited", fields: [invitedById], references: [id])
  reviewedBy   PortalUser?         @relation("Reviewed", fields: [reviewedById], references: [id])
  tokens       GymOnboardingToken[]
  followups    GymEnquiryFollowup[]
  @@map("gym_enquiries")
}

model GymOnboardingToken {
  token     String   @id
  enquiryId Int
  createdAt DateTime @default(now())
  expiresAt Int
  usedAt    DateTime?
  // When kind='followup', this token points the club at the Q&A page instead
  // of the first-time onboarding form.
  kind      String   @default("onboarding") // 'onboarding' | 'followup'
  enquiry   GymEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  @@map("gym_onboarding_tokens")
}

// Admin Q&A thread attached to a GymEnquiry — used when the admin needs
// more info before approving. One row per question, answered inline by the
// club via a signed followup link.
model GymEnquiryFollowup {
  id          Int      @id @default(autoincrement())
  enquiryId   Int
  askedById   Int?
  question    String
  answer      String   @default("")
  askedAt     DateTime @default(now())
  answeredAt  DateTime?
  enquiry     GymEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  @@index([enquiryId])
  @@map("gym_enquiry_followups")
}

// ---------------------------------------------------------------------------
// Promotions & events
// ---------------------------------------------------------------------------

model Promotion {
  id       Int    @id @default(autoincrement())
  ownerId  Int
  name     String
  owner    PortalUser @relation(fields: [ownerId], references: [id])
  events   Event[]
  @@map("promotions")
}

model Event {
  id                   Int      @id @default(autoincrement())
  title                String
  subtitle             String?
  startsAt             String?
  timezone             String?
  venue                String?
  city                 String?
  description          String?
  posterUrl            String?
  status               String   @default("Upcoming")
  promotionId          Int?
  registrationOpen     Int      @default(0)
  capacity             Int?
  registrationClosesAt String?
  categories           String   @default("[]")
  promotion            Promotion?         @relation(fields: [promotionId], references: [id])
  registrations        EventRegistration[]
  bouts                Bout[]
  @@map("events")
}

model EventRegistration {
  id              Int      @id @default(autoincrement())
  eventId         Int
  athleteId       Int
  addedById       Int?
  createdAt       DateTime @default(now())
  // 'interested' | 'offered' | 'accepted' | 'declined' | 'confirmed' | 'cancelled'
  status          String   @default("confirmed")
  registrationRef String?  @unique
  updatedAt       DateTime?
  // Admin's offer details (populated when status transitions to 'offered').
  offerNote       String   @default("")
  offerOpponent   String   @default("")
  offerDivision   String   @default("")
  offerSection    String   @default("")
  offerSentAt     DateTime?
  respondedAt     DateTime?
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athlete         Athlete  @relation(fields: [athleteId], references: [id])
  @@unique([eventId, athleteId])
  @@map("event_registrations")
}

model Bout {
  id              Int    @id @default(autoincrement())
  eventId         Int
  redAthleteId    Int
  blueAthleteId   Int
  boutOrder       Int    @default(0)
  cardSection     String @default("Main")
  division        String?
  winnerId        Int?
  resultMethod    String?
  resultRound     Int?
  resultTime      String?
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  red             Athlete  @relation("Red", fields: [redAthleteId], references: [id])
  blue            Athlete  @relation("Blue", fields: [blueAthleteId], references: [id])
  winner          Athlete? @relation("Winner", fields: [winnerId], references: [id])
  result          BoutResult?
  @@map("bouts")
}

model BoutResult {
  boutId     Int      @id
  outcome    String
  updatedBy  Int
  updatedAt  DateTime @default(now())
  bout       Bout     @relation(fields: [boutId], references: [id], onDelete: Cascade)
  @@map("bout_results")
}

model Ranking {
  id         Int      @id @default(autoincrement())
  athleteId  Int
  division   String
  position   Int
  movement   Int      @default(0)
  updatedAt  DateTime @default(now())
  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  @@unique([athleteId, division])
  @@map("rankings")
}

// ---------------------------------------------------------------------------
// Outbound mail log (log-only until SMTP is wired)
// ---------------------------------------------------------------------------

model OutboundMail {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  toAddress  String
  subject    String
  body       String
  category   String
  readAt     DateTime?
  @@index([createdAt(sort: Desc)])
  @@map("outbound_mail")
}

// ---------------------------------------------------------------------------
// Site settings
// ---------------------------------------------------------------------------

model SiteSetting {
  key   String @id
  value String
  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// Notifications (fighter portal)
// ---------------------------------------------------------------------------

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  kind      String   // 'new_division_peer' | ...
  title     String
  body      String   @default("")
  link      String   @default("")
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Self-declared fight history (fighter can add past bouts after approval)
// ---------------------------------------------------------------------------

model FightHistory {
  id          Int      @id @default(autoincrement())
  athleteId   Int
  fightDate   String   // yyyy-mm-dd
  opponent    String
  eventName   String   @default("")
  location    String   @default("")
  result      String   // 'win' | 'loss' | 'draw'
  method      String   @default("") // KO, Decision, Submission, etc.
  notes       String   @default("")
  createdAt   DateTime @default(now())
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@index([athleteId, fightDate])
  @@map("fight_history")
}

// ---------------------------------------------------------------------------
// News posts
// ---------------------------------------------------------------------------

model NewsPost {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  summary     String   @default("")
  body        String
  coverUrl    String   @default("")
  publishedAt DateTime?
  authorId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      PortalUser? @relation(fields: [authorId], references: [id])
  @@index([publishedAt(sort: Desc)])
  @@map("news_posts")
}

// Account deletion requests — user-initiated, admin-processed.
model AccountDeletionRequest {
  id            Int      @id @default(autoincrement())
  userId        Int
  athleteId     Int?
  reason        String   @default("")
  status        String   @default("pending") // 'pending' | 'processed'
  createdAt     DateTime @default(now())
  processedAt   DateTime?
  processedById Int?
  user          PortalUser @relation("DeletionRequester", fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt(sort: Desc)])
  @@map("account_deletion_requests")
}

// Verification requests — free-text submissions from fighters that an admin
// reviews. When verified, the submission is locked and the fighter can post
// a new one. Visible only to the admin team and the owning user.
model VerificationRequest {
  id            Int      @id @default(autoincrement())
  userId        Int
  athleteId     Int?
  body          String
  status        String   @default("pending") // 'pending' | 'verified' | 'rejected'
  adminNote     String   @default("")
  createdAt     DateTime @default(now())
  verifiedAt    DateTime?
  verifiedById  Int?
  user          PortalUser @relation("VerificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("verification_requests")
}
