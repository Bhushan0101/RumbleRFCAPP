# Cloudflare Workers deploy — reference only.
#
# Public vars live in wrangler.jsonc under `vars`.
# Secrets are set with `wrangler secret put <NAME>` and never committed.
#
# Required secrets (set once, after first deploy or before):
#   AUTH_SECRET  — 32+ random bytes, e.g. `openssl rand -base64 32`
#   AUTH_URL     — https://wucoireland.ie   (or your *.workers.dev url pre-domain)
#
# D1 binding:
#   wrangler d1 create wuco-prod
#   (paste the printed database_id into wrangler.jsonc)
#   npm run cf:d1:migrate      # applies prisma/migrations-d1/*.sql to the remote D1
#   npx wrangler d1 execute wuco-prod --remote --file=prisma/seed.sql  # optional seed
#
# Build + deploy:
#   npm run cf:build
#   npm run cf:preview         # local Workers runtime
#   npm run cf:deploy          # production
